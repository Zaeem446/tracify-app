# Stripe Configuration (REQUIRED)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# JWT Secret for Authentication (REQUIRED)
JWT_SECRET=your_random_secret_key_here_generate_a_long_random_string

# Application URL (REQUIRED for production)
APP_URL=https://tracify-geo.com

# Email/SMTP Configuration (REQUIRED for contact form & password emails)
# You can use Gmail, SendGrid, Mailgun, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Tracify <noreply@tracify-geo.com>"

# Database (optional - uses SQLite by default)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Twilio SMS Configuration (REQUIRED for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Server Port (auto-configured by Vercel)
PORT=3000
